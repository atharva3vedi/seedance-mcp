# Copy to ~/.seedance-mcp/.env (outside any repo), or pass these with `claude mcp add -e`.

# Required. BytePlus ModelArk > API Key Management.
ARK_API_KEY=

# Spend guard. Amounts are USD at BytePlus list prices.
SEEDANCE_ASK_ABOVE_USD=0.50     # ask before any single generation above this
SEEDANCE_BUDGET_USD=20          # ask before anything that crosses this...
SEEDANCE_BUDGET_PERIOD=month    # ...per day, week or month
SEEDANCE_HARD_CAP_USD=          # optional: never spend past this, approval or not
SEEDANCE_APPROVAL=auto          # auto | dialog | chat | off

# Optional
SEEDANCE_VIDEO_MODEL=mini       # default video model (alias or full id)
SEEDANCE_IMAGE_MODEL=pro        # default image model
SEEDANCE_OUTPUT_DIR=            # save every finished video and image here
SEEDANCE_PRICES_FILE=           # JSON with extra or corrected prices
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
